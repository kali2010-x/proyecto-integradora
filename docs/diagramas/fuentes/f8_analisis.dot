digraph F {   graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.3, ranksep=0.2, splines=polyline, bgcolor=white, pad=0.15];
  node  [fontname="DejaVu Sans", fontsize=11, shape=box, style="filled", fillcolor="#d7efed", color="#2a7f7a", penwidth=1.2, margin="0.1,0.03"];
  edge  [fontname="DejaVu Sans", fontsize=10, color="#3d5a59", arrowsize=0.7];
  n0 [label="Inicio", shape=box, style="rounded,filled", fillcolor="#1f7a6e", fontcolor=white, color="#1f7a6e"];
  n1 [label="Cargar cada bloque: meta.json,\ncorridas.jsonl y potencia.csv(.gz)", shape=polygon, sides=4, skew=0.28, fixedsize=true, width=3.64, height=0.68, fillcolor="#f3e6b8", color="#8a6d1d"];
  n2 [label="Potencia de reposo: media en la\nventana inicial; deriva con la final"];
  n3 [label="Energía de cada handshake:\nintegrar (P − P_reposo) entre su\ninicio y su fin (trapecios)"];
  n4 [label="Marcar corridas válidas\n(sin error, estado 0, sin throttling)"];
  n5 [label="Estadística por configuración:\nn, media, desviación, IC 95 %"];
  n6 [label="Comparar híbrido vs. clásico:\ndiferencia %, prueba de hipótesis,\nIC bootstrap"];
  n7 [label="Guardar resumen.csv, comparaciones.csv\ny figuras PNG", shape=polygon, sides=4, skew=0.28, fixedsize=true, width=3.98, height=0.68, fillcolor="#f3e6b8", color="#8a6d1d"];
  n8 [label="Fin", shape=box, style="rounded,filled", fillcolor="#1f7a6e", fontcolor=white, color="#1f7a6e"];
  q [label="¿Ensayo piloto?\n(tamano_muestra.py)", shape=diamond, fillcolor="#fff4d6", color="#b38a1d", margin="0.04,0.02"];
  j [label="Repeticiones necesarias (Jain):\nn = (100·z·s / (r·media))², r = 5 %\nn final = máx(n, 30)"];
  jo [label="Guardar tamano_muestra.csv", shape=polygon, sides=4, skew=0.28, fixedsize=true, width=2.96, height=0.49, fillcolor="#f3e6b8", color="#8a6d1d"];
  n0 -> n1 -> n2 -> n3 -> n4 -> n5 -> q;
  q -> j [label=" Sí"]; j -> jo -> n8;
  q -> n6 [label=" No (campaña)"]; n6 -> n7 -> n8;
}
