digraph F {   graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.3, ranksep=0.2, splines=polyline, bgcolor=white, pad=0.15];
  node  [fontname="DejaVu Sans", fontsize=11, shape=box, style="filled", fillcolor="#d7efed", color="#2a7f7a", penwidth=1.2, margin="0.1,0.03"];
  edge  [fontname="DejaVu Sans", fontsize=10, color="#3d5a59", arrowsize=0.7];
  a0 [label="Inicio", shape=box, style="rounded,filled", fillcolor="#1f7a6e", fontcolor=white, color="#1f7a6e"];
  a1 [label="Corridas sin TLS y con TLS híbrido\nregistrando todas las tramas"];
  a3 [label="Buscar el texto «TELEMETRIA»\nen cada registro de tramas"];
  a5 [label="Siguiente manipulación: alterar ESP32→Pi,\nalterar Pi→ESP32 o reinyectar trama;\nhandshake TLS híbrido"];
  a6 [label="Invertir un bit del registro cifrado\no reenviar uno anterior,\nrecalculando el CRC"];
  a7 [label="¿TLS rechazó la trama?\n(SSLError o estado < 0)", shape=diamond, fillcolor="#fff4d6", color="#b38a1d", margin="0.04,0.02"];
  a8 [label="Marcar rechazado = sí"];
  a8b [label="Marcar rechazado = no", fillcolor="#fbe3e3", color="#aa3333"];
  a9 [label="¿Quedan\nmanipulaciones?", shape=diamond, fillcolor="#fff4d6", color="#b38a1d", margin="0.04,0.02"];
  a10 [label="¿Texto visible sin TLS, oculto con TLS\ny todas rechazadas?", shape=diamond, fillcolor="#fff4d6", color="#b38a1d", margin="0.04,0.02"];
  a11 [label="TODAS LAS PRUEBAS PASARON"];
  a11b [label="REVISAR", fillcolor="#fbe3e3", color="#aa3333"];
  a12 [label="Guardar ataques_*.json", shape=polygon, sides=4, skew=0.28, fixedsize=true, width=2.62, height=0.49, fillcolor="#f3e6b8", color="#8a6d1d"];
  a13 [label="Fin", shape=box, style="rounded,filled", fillcolor="#1f7a6e", fontcolor=white, color="#1f7a6e"];
  a0 -> a1 -> a3 -> a5 -> a6 -> a7; a7 -> a8 [label=" Sí"]; a7 -> a8b [label=" No"];
  a8 -> a9; a8b -> a9; a9 -> a5 [label=" Sí"]; a9 -> a10 [label=" No"];
  a10 -> a11 [label=" Sí"]; a10 -> a11b [label=" No"]; a11 -> a12; a11b -> a12; a12 -> a13;
}
