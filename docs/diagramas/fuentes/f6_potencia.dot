digraph F {   graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.3, ranksep=0.2, splines=polyline, bgcolor=white, pad=0.15];
  node  [fontname="DejaVu Sans", fontsize=11, shape=box, style="filled", fillcolor="#d7efed", color="#2a7f7a", penwidth=1.2, margin="0.1,0.03"];
  edge  [fontname="DejaVu Sans", fontsize=10, color="#3d5a59", arrowsize=0.7];
  p0 [label="Inicio", shape=box, style="rounded,filled", fillcolor="#1f7a6e", fontcolor=white, color="#1f7a6e"];
  p1 [label="Configurar INA219 (0x40)\nresolución 12 bits, 1 muestra"];
  p2 [label="Abrir CSV: t_ns, V, mA, mW", shape=polygon, sides=4, skew=0.28, fixedsize=true, width=2.96, height=0.49, fillcolor="#f3e6b8", color="#8a6d1d"];
  p3 [label="Leer voltaje y corriente;\nP = V · I y marca de tiempo"];
  p4 [label="Escribir fila en el CSV", shape=polygon, sides=4, skew=0.28, fixedsize=true, width=2.71, height=0.49, fillcolor="#f3e6b8", color="#8a6d1d"];
  p5 [label="¿Señal de parada o\nduración cumplida?", shape=diamond, fillcolor="#fff4d6", color="#b38a1d", margin="0.04,0.02"];
  p6 [label="Cerrar archivo e informar\nmuestras por segundo", shape=polygon, sides=4, skew=0.28, fixedsize=true, width=2.88, height=0.68, fillcolor="#f3e6b8", color="#8a6d1d"];
  p7 [label="Fin", shape=box, style="rounded,filled", fillcolor="#1f7a6e", fontcolor=white, color="#1f7a6e"];
  p0 -> p1 -> p2 -> p3 -> p4 -> p5; p5 -> p3 [label=" No"]; p5 -> p6 [label=" Sí"]; p6 -> p7;
}
