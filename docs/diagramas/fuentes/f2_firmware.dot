digraph F {   graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.3, ranksep=0.2, splines=polyline, bgcolor=white, pad=0.15];
  node  [fontname="DejaVu Sans", fontsize=11, shape=box, style="filled", fillcolor="#d7efed", color="#2a7f7a", penwidth=1.2, margin="0.1,0.03"];
  edge  [fontname="DejaVu Sans", fontsize=10, color="#3d5a59", arrowsize=0.7];
  ini [label="Inicio (arranque del ESP32)", shape=box, style="rounded,filled", fillcolor="#1f7a6e", fontcolor=white, color="#1f7a6e"];
  cfg [label="Configurar READY, cola de tramas e I2C esclavo (0x28);\ncrear tarea de enlace (núcleo 0) y tarea TLS (núcleo 1)"];
  rel [label="Fijar el reloj (fecha de compilación + 1 día)\ne iniciar wolfSSL con contador de memoria"];
  esp [label="¿Llegó una\norden START?", shape=diamond, fillcolor="#fff4d6", color="#b38a1d", margin="0.04,0.02"];
  sin [label="¿Grupo\nsin TLS?", shape=diamond, fillcolor="#fff4d6", color="#b38a1d", margin="0.04,0.02"];
  eco [label="Eco en claro de n mensajes\n(control)"];
  ctx [label="Crear contexto TLS 1.3\ny cargar certificado de la CA"];
  okc [label="¿Certificado\nválido?", shape=diamond, fillcolor="#fff4d6", color="#b38a1d", margin="0.04,0.02"];
  grp [label="Ofrecer grupo X25519\no X25519MLKEM768"];
  hs  [label="Handshake TLS (SSL_connect)\nmedir tiempo y memoria pico"];
  okh [label="¿Handshake\ncorrecto?", shape=diamond, fillcolor="#fff4d6", color="#b38a1d", margin="0.04,0.02"];
  tel [label="Enviar n mensajes de telemetría\ny recibir su eco cifrado"];
  blk [label="Enviar bloque de 4 KiB\n(rendimiento) y cerrar sesión"];
  err [label="Registrar código\nde error (estado < 0)", fillcolor="#fbe3e3", color="#aa3333"];
  rep [label="Enviar reporte R/Q a la Raspberry\n(estado, tiempos, memoria)", shape=polygon, sides=4, skew=0.28, fixedsize=true, width=3.56, height=0.68, fillcolor="#f3e6b8", color="#8a6d1d"];
  ini -> cfg -> rel -> esp;
  esp -> esp [label=" No"];
  esp -> sin [label=" Sí"];
  sin -> eco [label=" Sí"]; sin -> ctx [label=" No"];
  ctx -> okc; okc -> grp [label=" Sí"]; okc -> err [label=" No"];
  grp -> hs -> okh; okh -> tel [label=" Sí"]; okh -> err [label=" No"];
  tel -> blk -> rep; eco -> rep; err -> rep;
  rep -> esp [constraint=false, label=" siguiente corrida"];
}
