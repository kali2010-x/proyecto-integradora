digraph F {   graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.3, ranksep=0.2, splines=polyline, bgcolor=white, pad=0.15];
  node  [fontname="DejaVu Sans", fontsize=11, shape=box, style="filled", fillcolor="#d7efed", color="#2a7f7a", penwidth=1.2, margin="0.1,0.03"];
  edge  [fontname="DejaVu Sans", fontsize=10, color="#3d5a59", arrowsize=0.7];
  s0 [label="Inicio de corrida\n(grupo, tamaño de mensaje)", shape=box, style="rounded,filled", fillcolor="#1f7a6e", fontcolor=white, color="#1f7a6e"];
  s1 [label="Reiniciar el enlace\nen ambos extremos"];
  s2 [label="¿Reinicio\ncorrecto?", shape=diamond, fillcolor="#fff4d6", color="#b38a1d", margin="0.04,0.02"];
  s2e [label="Error: reset_fallido", fillcolor="#fbe3e3", color="#aa3333"];
  s3 [label="Enviar orden START al ESP32", shape=polygon, sides=4, skew=0.28, fixedsize=true, width=3.05, height=0.49, fillcolor="#f3e6b8", color="#8a6d1d"];
  s4 [label="¿Grupo\nsin TLS?", shape=diamond, fillcolor="#fff4d6", color="#b38a1d", margin="0.04,0.02"];
  s5 [label="Devolver en claro\nn mensajes (control)"];
  s6 [label="Handshake TLS 1.3 (OpenSSL): registrar etapas,\nbytes y grupo negociado (tamaño del ServerHello)"];
  s8 [label="Eco cifrado de n mensajes\nde telemetría"];
  s9 [label="¿Bloque de\nrendimiento?", shape=diamond, fillcolor="#fff4d6", color="#b38a1d", margin="0.04,0.02"];
  s10 [label="Recibir 4 KiB y calcular\nrendimiento útil (kbit/s)"];
  s11 [label="Esperar cierre de sesión\n(close_notify)"];
  ex [label="Excepción SSL / tiempo\nagotado: registrar error", fillcolor="#fbe3e3", color="#aa3333"];
  s12 [label="Esperar reporte del ESP32 y agregar\ncontadores del enlace (resultado JSON)", shape=polygon, sides=4, skew=0.28, fixedsize=true, width=3.98, height=0.68, fillcolor="#f3e6b8", color="#8a6d1d"];
  s14 [label="Fin", shape=box, style="rounded,filled", fillcolor="#1f7a6e", fontcolor=white, color="#1f7a6e"];
  s0 -> s1 -> s2; s2 -> s3 [label=" Sí"]; s2 -> s2e [label=" No"]; s2e -> s14;
  s3 -> s4; s4 -> s5 [label=" Sí"]; s4 -> s6 [label=" No"];
  s6 -> s8 -> s9; s9 -> s10 [label=" Sí"]; s9 -> s11 [label=" No"]; s10 -> s11;
  s5 -> s12; s11 -> s12; s6 -> ex [style=dashed, color="#aa3333"]; s8 -> ex [style=dashed, color="#aa3333"]; ex -> s12;
  s12 -> s14;
}
